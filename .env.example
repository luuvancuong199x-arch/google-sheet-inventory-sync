# ============================================================
# CẤU HÌNH MÔI TRƯỜNG - VHUB GOOGLE SHEET INVENTORY SYNC ENGINE
# Copy file này thành '.env' trước khi chạy trên máy local / VPS:
#   cp .env.example .env
# LƯU Ý: Tuyệt đối KHÔNG commit file '.env' hoặc 'credentials.json' lên Git!
# ============================================================

# 1. Xác thực Google Service Account (chọn 1 trong 2 cách)
# Cách A: Trỏ đường dẫn tới file JSON key của Service Account
GOOGLE_APPLICATION_CREDENTIALS=/root/vhub/google-sheet-inventory-sync/credentials.json
# Cách B: Truyền trực tiếp nội dung JSON (phù hợp với GitHub Actions / Docker / cloud env)
# GCP_SA_KEY={"type":"service_account",...}

# 2. Kết nối Cơ sở dữ liệu PostgreSQL (VHUB Web Database)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=lockcan
DB_PASSWORD=your_db_password_here
DB_NAME=lockcan

# Bật/tắt chế độ tự động đồng bộ DB trong một số flow (CLI sử dụng cờ --write-db)
DB_SYNC=true
